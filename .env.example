# Core configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=books_monitor
BASE_URL=https://books.toscrape.com

# Crawler
CONCURRENCY=12
REQUEST_TIMEOUT=20
MAX_RETRIES=3
USER_AGENT=BooksMonitorBot/1.0 (+https://example.com/bot)

# API
API_KEYS=dev-key-1
RATE_LIMIT_PER_HOUR=100
LOG_LEVEL=INFO

# Scheduler (cron format: min hour day month weekday)
SCHEDULER_CRON=0 2 * * *
# Instead of CRON, you can use interval seconds (uncomment to enable). If set, interval wins over CRON.
# SCHEDULER_INTERVAL_SECONDS=86400
# Run a job immediately when the scheduler starts (true/false)
SCHEDULER_RUN_ON_START=true
# Run the APScheduler inside the FastAPI API process (true/false)
RUN_SCHEDULER_IN_API=true

# Optional Redis URL for distributed rate limiting (not needed in local testing)
# REDIS_URL=redis://localhost:6379/0
